# Browser-safe Supabase credentials only.
# Copy this file to .env.local and replace the placeholders with your own values.
# Never use a secret/service-role key here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Development server only.
# Camera bypass is additionally guarded by import.meta.env.DEV.
VITE_ENABLE_CAMERA_BYPASS=false

# Optional JSON array.
# Configure your own TURN/STUN infrastructure when needed.
# VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"}]