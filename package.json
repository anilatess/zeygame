{
  "name": "kamera-parti-oyunu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc -b && vite build --configLoader runner && node scripts/generate-service-worker.mjs",
    "preview": "vite preview",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "verify": "node scripts/verify-all.mjs",
    "validate": "npm run typecheck && npm run format:check && npm run build && npm run verify",
    "verify:online-phase2": "node scripts/verify-online-phase2.mjs",
    "verify:camera-preparation": "node scripts/verify-camera-preparation.mjs",
    "verify:online-phase3": "node scripts/verify-online-phase3.mjs",
    "verify:online-phase4": "node scripts/verify-online-phase4.mjs",
    "verify:online-phase5": "node scripts/verify-online-phase5.mjs",
    "verify:online-countdown-start": "node scripts/verify-online-countdown-start.mjs",
    "verify:online-entry-ui": "node scripts/verify-online-entry-ui.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
